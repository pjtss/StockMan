        "sourceClass": "OFFICIAL_DOCUMENT_BODY",
        "action": "FETCH",
        "apiCredentialValid": true,
        "retentionDecision": "UNRESOLVED"
      },
      "expected": {
        "fetch": "BLOCKED_UNTIL_ACTION_DECISION",
        "persistRaw": "BLOCKED",
        "credentialValidityIsAuthorization": false
      }
    },
    {
