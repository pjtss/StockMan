{
  "contractVersion": "financing-adjudication-package.v0",
  "classification": "SYNTHETIC_DESIGN_FIXTURES_NOT_RUNTIME_ACCEPTANCE",
  "dataPolicy": {
    "containsRealFiling": false,
    "containsRealIssuerOrTicker": false,
    "containsSourceBody": false,
    "hashesAreSyntheticLabels": true
  },
  "caseStates": ["RESOLVED_FOR_SCOPE", "PARTIAL", "UNRESOLVED", "RIGHTS_BLOCKED", "SOURCE_UNAVAILABLE", "REOPENED"],
  "fieldMatchClasses": ["MATCH", "VALUE_CONFLICT", "SEMANTIC_MISMATCH", "EXPLICIT_EMPTY", "NOT_RETURNED", "NOT_IN_VERSION", "PARSE_ERROR", "NOT_APPLICABLE", "UNVERIFIABLE_RIGHTS", "UNLOCATABLE"],
  "vectors": [
    {
      "id": "FAP-01-SAMPLE-DENOMINATOR-KEEPS-UNAVAILABLE",
      "input": { "selected": 20, "reviewed": 16, "sourceUnavailable": 2, "rightsBlocked": 1, "notYetReviewed": 1 },
      "expected": { "selectedEqualsDispositionSum": true, "unavailableStaysInDenominator": true, "caseState": "INCOMPLETE", "forbiddenPublicText": ["16건을 전체 검토 완료로 표시", "미취득 4건을 분모에서 삭제"] }
    },
    {
      "id": "FAP-02-EXPLICIT-ZERO-REQUIRES-LOCATOR",
      "input": { "structuredState": "PRESENT", "structuredValue": "0", "bodyState": "PRESENT", "bodyValue": "0", "bodyLocator": "SYNTHETIC-LOCATOR-1" },
      "expected": { "fieldMatchClass": "MATCH", "zeroMeaning": "SOURCE_EXPLICIT_ZERO_ONLY", "forbiddenPublicText": ["빈 필드도 0으로 표시", "locator 없이 원문 일치 확정"] }
    },
    {
      "id": "FAP-03-REVIEW-DISAGREEMENT-NEEDS-ADJUDICATOR",
      "input": { "reviewerA": "MATCH", "reviewerB": "VALUE_CONFLICT", "adjudicator": null },
      "expected": { "reviewState": "DISPUTED", "caseState": "UNRESOLVED", "agreementCount": 0, "forbiddenPublicText": ["다수 label을 정답으로 확정", "이견을 합의 처리"] }
    },
    {
      "id": "FAP-04-UNRELATED-SAME-ISSUER-NOT-CORRECTION",
      "input": { "fromReceipt": "SYNTH-R1", "toReceipt": "SYNTH-R2", "sameIssuer": true, "titleSimilarity": "HIGH", "explicitRelationEvidence": null },
      "expected": { "relationDecision": "UNRESOLVED", "correctionEdgeCreated": false, "forbiddenPublicText": ["같은 회사·유사 제목이므로 정정 연결", "날짜 근접성을 정정 근거로 처리"] }
    },
    {
      "id": "FAP-05-RIGHTS-BLOCKED-IS-NOT-CONTENT-PASS",
      "input": { "rightsAction": "REVIEW_SOURCE_BODY", "rightsStatus": "NEEDS_REVIEW", "bodyCopied": false },
      "expected": { "caseState": "RIGHTS_BLOCKED", "contentJudgment": "NOT_RUN", "forbiddenPublicText": ["권리 미확인을 검토 통과로 처리", "원문을 fixture에 복사해 저장"] }
    },
    {
      "id": "FAP-06-APPROVAL-STALE-AFTER-GUIDE-SHAPE-CHANGE",
      "input": { "approvedGuideVersion": "GUIDE-A", "currentGuideVersion": "GUIDE-B", "responseShapeChanged": true },
      "expected": { "priorApproval": "EXPIRED_FOR_AFFECTED_SCOPE", "newReviewRequired": true, "forbiddenPublicText": ["기존 승인 자동 재사용", "응답 필드 변화 무시"] }
    },
    {
      "id": "FAP-07-RECEIPT-CARDINALITY-MISMATCH-INCOMPLETE",
      "input": { "manifestSelected": 5, "terminalDispositionRows": 4, "reconciliationRows": 0 },
      "expected": { "caseState": "INCOMPLETE", "publication": "SUPPRESS_ACCEPTANCE_RESULT", "forbiddenPublicText": ["분모 차이를 무시하고 PASS", "미분류 receipt를 제외"] }
    },
    {
      "id": "FAP-08-PARTIAL-SCOPE-REVIEW-PRESERVES-UNRELATED-CLAIMS",
      "input": { "claimA": "RESOLVED", "claimB": "UNLOCATABLE", "dependencyClaimB": ["DATE-2", "IMPACT-2"] },
      "expected": { "claimA": "RETAIN_WITHIN_REVIEWED_SCOPE", "claimB": "SUPPRESSED", "unrelatedSuppression": false, "forbiddenPublicText": ["모든 claim 일괄 확정", "무관한 claim까지 이유 없이 전체 삭제"] }
    }
  ]
}
