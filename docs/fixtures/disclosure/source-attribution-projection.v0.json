      "expected": {
        "attemptStoresPairedCreditComponents": true,
        "manifestArrayOrderAffectsHash": true,
        "receiptAttributionReconstructable": true
      }
    },
    {
      "id": "SAP-12-POLICY-REVISION-FENCES-STALE-RETRY",
      "input": {
        "queuedPolicyRevision": "POLICY-1",
        "currentPolicyRevision": "POLICY-2",
        "providerOutcome": "ATTEMPTED_UNKNOWN"
      },
      "expected": {
        "oldPayloadRetry": "SUPPRESSED_UNTIL_REBUILD",
        "newRightsCheckRequired": true,
        "blindDuplicateRetry": false
      }
    },
    {
      "id": "SAP-13-CORRECTION-RECONCILES-CREDIT-IMPACT-PER-CHANNEL",
      "input": {
        "recipientCount": 2,
        "channelCount": 2,
        "creditPolicyChanged": true,
        "impactLedgerComplete": false
      },
      "expected": {
        "expectedRecipientChannelCount": 4,
        "correctionState": "DELIVERY_SCOPE_UNRESOLVED",
        "reconciled": false
      }
    },
    {
      "id": "SAP-14-CREDIT-TEXT-HASH-USES-EXACT-RENDERED-UTF8",
