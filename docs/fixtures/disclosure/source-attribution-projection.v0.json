    "unicodeNormalization": "NONE_PRESERVE_CODE_POINTS",
    "hashFormula": "SHA256(UTF8(domainSeparator) || 0x00 || UTF8(exactCanonicalCreditText))",
    "linkTreatment": "credit text hash excludes URL; safe destination URL is a separate typed field in the credit component and is covered by payloadHash",
    "rendererBinding": "rendererRevision and locale are pinned; escaped channel output is covered by payloadHash, and any renderer/locale change requires a rebuild",
    "retryRule": "retry may reuse payload only when payloadHash, creditManifestHash, rendererRevision, locale, notificationRevision, rightsDecisionRevision and attributionPolicyRevision all match the current authorized attempt"
