        "canonicalCredit": "출처: [합성](https://example.invalid)",
        "channel": "DISCORD",
        "rendererRevision": "DISCORD-SYN-1"
      },
      "expected": {
        "creditTextHashInput": "CANONICAL_AFTER_LOCALE_BEFORE_CHANNEL_ESCAPE",
        "escapedOutputHashDiffersPermitted": true,
        "payloadHashCoversEscapedOutput": true
      }
    },
    {
      "id": "SAP-18-LINEBREAK-OR-CONTROL-CHARACTER-CHANGE-INVALIDATES-ATTEMPT",
      "input": {
        "creditText": "출처: 합성\n추가 줄",
        "mutatedCreditText": "출처: 합성 추가 줄",
        "containsControlInjection": true
      },
      "expected": {
        "linebreakMutationChangesCreditTextHash": true,
        "controlInjectionDisposition": "REJECT_OR_SANITIZE_WITH_NEW_RENDERER_OUTPUT",
        "priorPayloadReusable": false
      }
    },
    {
      "id": "SAP-19-SAFE-LINK-CHANGE-CHANGES-PAYLOAD-NOT-CREDIT-TEXT-HASH",
      "input": {
        "creditText": "출처: 합성 자료",
        "priorSafeUrl": "https://example.invalid/a",
        "currentSafeUrl": "https://example.invalid/b"
      },
      "expected": {
        "creditTextHashUnchanged": true,
        "payloadHashChanged": true,
        "priorPayloadReusable": false
      }
    },
    {
      "id": "SAP-20-CHANNEL-RENDERER-REVISION-IS-PINNED-PER-ATTEMPT",
      "input": {
        "priorRendererRevision": "DISCORD-1",
        "currentRendererRevision": "DISCORD-2",
        "canonicalCreditTextUnchanged": true
      },
      "expected": {
        "priorAttemptImmutable": true,
        "newPayloadHashRequired": true,
        "receiptReferencesRendererRevision": true
      }
    }
  ],
  "creditTextHashContract": {
    "domainSeparator": "KR-DISCLOSURE-CREDIT-TEXT-v1",
    "input": "UTF8(exact locale-selected canonical credit text before any channel-specific escaping or markup)",
