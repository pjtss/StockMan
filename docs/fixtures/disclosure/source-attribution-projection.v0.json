  "officialSourceLinkPolicy": {
    "status": "PROPOSED_DART_VIEWER_ONLY_KIND_VIEWER_TEMPLATE_UNRESOLVED",
    "sourceEvidence": {
      "officialGuide": "https://opendart.fss.or.kr/guide/detail.do?apiGrpCd=DS001&apiId=2019001",
      "projectBuilder": "lib/dart-automation-mapper.ts"
    },
    "allowed": {
      "scheme": "https:",
      "hostname": "dart.fss.or.kr",
      "pathname": "/dsaf001/main.do",
      "query": "exactly one rcpNo parameter with exactly 14 ASCII digits",
      "canonicalOutput": "https://dart.fss.or.kr/dsaf001/main.do?rcpNo={14-digit-rcept-no}"
    },
    "reject": [
      "non-HTTPS",
      "userinfo",
      "non-default port",
      "host suffix/lookalike",
      "unexpected path",
      "duplicate or extra query keys",
      "redirect/destination parameters",
      "encoded or non-canonical query representation",
      "fragment",
      "missing/malformed/non-14-digit rcpNo"
    ],
    "handling": {
      "validation": "parse only; do not fetch or follow redirects",
      "output": "reconstruct canonical viewer URL from validated 14-digit rcpNo; never return original candidate URL",
      "unknownSource": "UNRESOLVED_SUPPRESS_LINK",
      "kind": "do not auto-allow until official KIND viewer URL contract and current code path are verified"
    },
    "browserUse": "Open only the reconstructed canonical direct viewer link; UI must not perform server-side link preview or redirect resolution"
  },
