  "cases": [
    {
      "id": "SAP-01-REQUIRED-CREDIT-TRAVELS-WITH-CLAIM",
      "input": {
        "claimCount": 1,
        "sourceCount": 1,
        "creditState": "CREDIT_REQUIRED",
        "creditTextAvailable": true,
        "surfaceAllowed": true
      },
      "expected": {
        "claimDisplay": "ALLOWED_WITH_LINKED_CREDIT",
        "creditBoundToClaimRevision": true
      }
    },
    {
      "id": "SAP-02-MULTIPLE-SOURCES-KEEP-SEPARATE-CREDITS",
      "input": {
        "claimCount": 2,
        "sourceProducts": [
          "SYNTH-PRODUCT-A",
          "SYNTH-PRODUCT-B"
        ],
        "policyRevisions": [
          "POLICY-A1",
          "POLICY-B4"
        ]
      },
      "expected": {
        "creditCount": 2,
        "singleInheritedLicenseBadge": false,
        "lineagePerClaim": true
      }
    },
    {
      "id": "SAP-03-UNRESOLVED-CREDIT-WITHHOLDS-DERIVATIVE",
      "input": {
        "claimCount": 1,
        "creditState": "CREDIT_POLICY_UNRESOLVED",
        "summaryDependsOnClaim": true
      },
      "expected": {
        "claimDisplay": "WITHHELD",
        "summaryDisplay": "WITHHELD",
        "sourceStatusFallbackRequiresSeparateDecision": true
      }
    },
    {
      "id": "SAP-04-ATTRIBUTION-DOES-NOT-GRANT-REDISTRIBUTION",
      "input": {
        "creditState": "CREDIT_REQUIRED",
        "attributionProvided": true,
        "distributionRight": "UNRESOLVED"
      },
      "expected": {
        "distribution": "BLOCKED",
        "creditIsPermission": false
      }
    },
    {
      "id": "SAP-05-NOTIFICATION-USES-SURFACE-SPECIFIC-CREDIT",
      "input": {
        "displaySurface": "PUSH",
        "pushCreditDecision": "ALLOW_WITH_CONTROLS",
        "detailCreditDecision": "ALLOW",
        "fullSourceBodyRequested": true
      },
      "expected": {
        "payload": "MINIMAL_APPROVED_CREDIT_AND_SAFE_LINK",
        "fullSourceBodyIncluded": false,
        "detailDecisionInherited": false
      }
    },
    {
      "id": "SAP-06-API-EXPORT-CANNOT-STRIP-REQUIRED-CREDIT",
      "input": {
        "displaySurface": "PUBLIC_API",
        "creditState": "CREDIT_REQUIRED",
        "serializerHasCreditField": false
      },
      "expected": {
        "response": "BLOCKED",
        "dataOnlyFallback": false
      }
    },
    {
      "id": "SAP-07-CORRECTION-PINS-NEW-EVIDENCE-CREDIT-REVISION",
      "input": {
        "priorEvidenceRevision": "EVIDENCE-1",
        "currentEvidenceRevision": "EVIDENCE-2",
        "priorCreditPolicyRevision": "POLICY-1"
      },
      "expected": {
        "priorProjection": "HISTORICAL_IMMUTABLE",
        "currentProjection": "RECOMPUTE_AND_REVIEW",
        "oldCreditAutoInherited": false
      }
    },
    {
      "id": "SAP-08-CATALOG-LICENSE-DOES-NOT-CROSS-SOURCE-CLASS",
      "input": {
        "catalogLicenseSourceClass": "LIST_METADATA",
        "targetSourceClass": "OFFICIAL_DOCUMENT_BODY",
        "targetLicenseEvidence": null
      },
      "expected": {
        "targetRights": "UNRESOLVED",
        "targetCredit": "CREDIT_POLICY_UNRESOLVED",
        "inheritance": false
      }
    },
    {
      "id": "SAP-09-REQUIRED-CREDIT-IS-NEVER-TRUNCATED-TO-FIT",
      "input": {
        "displaySurface": "PUSH",
        "requiredCreditFits": false,
        "approvedShortCredit": false,
        "approvedCreditPreservingLink": false
      },
      "expected": {
        "payload": "SUPPRESSED",
        "contentWithoutCredit": false,
        "truncateRequiredCredit": false
      }
    },
    {
      "id": "SAP-10-PROVIDER-ACCEPTANCE-IS-NOT-DEVICE-DELIVERY",
      "input": {
        "providerOutcome": "ACCEPTED",
        "deviceDeliveryObservation": "UNOBSERVED",
        "payloadCreditIds": [
          "CREDIT-SYNTH-1"
        ]
      },
      "expected": {
        "providerState": "PROVIDER_ACCEPTED",
        "deviceState": "DEVICE_DELIVERY_UNOBSERVED",
        "creditDeliveredClaim": false
      }
    },
    {
      "id": "SAP-11-ATTEMPT-PRESERVES-EXACT-CREDIT-PROJECTION-HASH",
      "input": {
        "creditComponents": [
