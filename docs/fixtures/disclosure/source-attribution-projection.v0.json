      },
      "expected": {
        "priorPayloadReusable": false,
        "newPayloadHashRequired": true,
        "newRightsAndCreditCheckRequired": true
      }
    },
    {
      "id": "SAP-17-CHANNEL-ESCAPING-DOES-NOT-REWRITE-CANONICAL-CREDIT",
