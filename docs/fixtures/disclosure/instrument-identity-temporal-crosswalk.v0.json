        "automaticReapproval": false
      }
    },
    {
      "id": "ITC-24-RIGHTS-EXPIRY-CLOSES-ACTION-WITHOUT-DELETING-ASSERTION-HISTORY",
      "input": {
        "approvedAssertionId": "ASSERTION-SYN-24-A",
        "rightsExpiryAt": "SYNTH-EXPIRY",
        "currentTime": "SYNTH-AFTER-EXPIRY",
        "historicalAssertionRetention": "APPROVED"
      },
      "expected": {
        "sourceActionAllowed": false,
        "priorAssertionImmutable": true,
        "publicDescendantActive": false,
        "rightsApprovalRenewalRequired": true
