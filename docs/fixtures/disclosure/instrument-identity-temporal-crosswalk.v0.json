{
  "contractVersion": "instrument-identity-temporal-crosswalk.v0",
  "classification": "SYNTHETIC_DESIGN_FIXTURES_NOT_RUNTIME_ACCEPTANCE",
  "dataPolicy": {
    "containsRealFiling": false,
    "containsRealIssuerOrTicker": false,
    "containsCredentials": false,
    "identitiesAreSynthetic": true
  },
  "identityLayers": [
    "LEGAL_ENTITY_IDENTITY",
    "SECURITY_INSTRUMENT_IDENTITY",
    "MARKET_CODE_ALIAS",
    "ELIGIBILITY_ASSERTION"
  ],
  "requiredAliasAssertionFields": [
    "aliasAssertionId",
    "instrumentId",
    "market",
    "code",
    "securityClass",
    "validFrom",
    "validUntil",
    "observedAt",
    "masterSnapshotId",
    "masterContentHash",
    "sourceEvidenceRef",
    "relationType",
    "reviewState"
  ],
  "relationTypes": [
    "IDENTIFIES",
    "RENAMED_AS",
    "REPLACED_BY",
    "MERGED_INTO",
    "SPLIT_INTO",
    "CODE_REUSED_BY",
    "CLASS_CHANGED_TO"
  ],
  "officialSourceRoles": [
    "CURRENT_VENDOR_SUPPORTED_INSTRUMENT",
    "LEGAL_ENTITY_OR_FILER_ID",
    "EXCHANGE_LISTING_EFFECTIVE_STATUS",
    "SECURITY_CLASS",
    "PRICE_OBSERVATION_VENUE",
    "SOURCE_COVERAGE"
  ],
  "requiredEvidenceEnvelopeFields": [
    "fieldName",
    "assertedValue",
    "instrumentId",
    "issuerRelation",
    "venueId",
    "securityClass",
    "validFrom",
    "validUntil",
    "observedAt",
    "sourceAuthority",
    "sourceRecordRef",
    "sourceContentHash",
    "queryWindow",
    "rowPageDenominator",
    "sourceRevisionOrEffectiveNoticeTime",
    "parserRevision",
    "rightsUsePurposeState",
    "reviewState"
  ],
  "crosswalkReviewRoles": [
    "CANDIDATE_DISCOVERY",
    "EVIDENCE_PREPARER",
    "INSTRUMENT_REVIEWER",
    "INDEPENDENT_REVIEWER",
    "DECISION_OWNER",
    "AUDITOR_READ_ONLY"
  ],
  "requiredCrosswalkReviewDecisionFields": [
    "reviewDecisionId",
    "revision",
    "assertionId",
    "assertionRevision",
    "decision",
    "reasonCode",
    "reviewerActorId",
    "reviewerRoleSnapshot",
    "independentReviewerRef",
    "evidencePacketId",
    "evidencePacketHash",
    "boundPolicyDecisionRevisions",
    "sourceRightsRetentionScope",
    "validFrom",
    "validUntil",
    "effectiveAt",
    "recordedAt",
    "expiryOrReopenCondition",
    "expectedPriorRevision",
    "precedingDecisionRef"
  ],
  "crosswalkReviewDecisionBindings": [
    "KR-MASTER-SNAPSHOT-01",
    "KR-EVENT-ATTRIBUTION-01",
    "KR-OPERATIONAL-SECURITY-01",
    "KR-RETENTION-01",
    "KR-DART-RIGHTS-01",
    "KR-MARKET-DATA-RIGHTS-01"
  ],
  "ownerDecisionPackageContractRef": "decision-register-lifecycle.v0.json",
  "ownerDecisionPackageFieldsSource": "requiredDecisionRecordFields",
  "reviewUiPolicyDecisionStates": [
    "OPEN",
    "EVIDENCE_READY",
    "APPROVED",
    "CLOSED",
    "REJECTED",
    "EXPIRED"
  ],
  "reviewUiAssertionStates": [
    "DISCOVERED",
    "EVIDENCE_INCOMPLETE",
    "READY_FOR_REVIEW",
    "IN_REVIEW",
    "CONFLICT_UNRESOLVED",
    "APPROVED_ASSERTION",
    "REJECTED",
    "REVIEW_REQUIRED",
    "EXPIRED"
  ],
  "reviewUiActions": [
    "ASSIGN_REVIEWER",
    "REQUEST_EVIDENCE",
    "MARK_EVIDENCE_READY",
    "APPROVE_POLICY_SCOPE",
    "APPROVE_ASSERTION",
    "REJECT_WITH_REASON",
    "RESOLVE_CONFLICT",
    "REOPEN",
    "EXPIRE"
  ],
  "eligibilityEvidenceFields": [
    "instrumentId",
    "effectiveAt",
    "masterSnapshotId",
    "instrumentType",
    "activeState",
    "marketCapValue",
    "marketCapCurrency",
    "marketCapObservedAt",
    "decisionState"
  ],
  "vectors": [
    {
      "id": "ITC-01-DART-CORPORATION-CODE-IS-NOT-INSTRUMENT-IDENTITY",
      "input": {
        "corpCode": "SYNTH-CORP-A",
        "stockCode": "123456",
        "market": "KR"
      },
      "expected": {
        "entityAndInstrumentSeparated": true,
        "instrumentIdentityFromStockCodeAlone": false
      }
    },
    {
      "id": "ITC-02-MASTER-LATEST-CHANGE-DATE-IS-NOT-HISTORICAL-CROSSWALK",
      "input": {
        "masterSnapshot": "CURRENT_ONLY",
        "eventEffectiveAt": "SYNTH-PAST",
        "historicalAliasEvidence": null
      },
      "expected": {
        "historicalMapping": "UNRESOLVED",
        "inferFromCurrentAlias": false
      }
    },
    {
      "id": "ITC-03-REUSED-CODE-DOES-NOT-MERGE-TWO-INSTRUMENTS",
      "input": {
        "sameMarket": true,
        "sameCode": true,
        "validIntervalsDisjoint": true,
        "instrumentIds": [
          "SYNTH-INST-A",
          "SYNTH-INST-B"
        ]
      },
      "expected": {
        "identityMerge": false,
        "aliasRows": 2,
        "codeReuseRelationRequired": true
      }
    },
    {
      "id": "ITC-04-RENAME-REQUIRES-EFFECTIVE-DATE-AND-CONTINUITY-EVIDENCE",
      "input": {
        "sameIssuerNameSimilarity": true,
        "officialContinuityEvidence": false,
        "validFrom": null
      },
      "expected": {
        "sameInstrument": "UNRESOLVED",
        "tickerNameSimilaritySufficient": false
      }
    },
    {
      "id": "ITC-05-MERGER-SUCCESSOR-IS-NOT-SILENTLY-THE-SAME-INSTRUMENT",
      "input": {
        "predecessorInstrumentId": "SYNTH-INST-A",
        "successorInstrumentId": "SYNTH-INST-B",
        "relation": "MERGED_INTO",
        "reviewed": false
      },
      "expected": {
        "instrumentIdentitySame": false,
        "relationPending": true,
        "eventSubjectRetargeted": false
      }
    },
    {
      "id": "ITC-06-SECURITY-CLASS-CHANGE-KEEPS-DISTINCT-INSTRUMENT-IDENTITY",
      "input": {
        "entityId": "SYNTH-ENTITY-A",
        "oldClass": "PREFERRED",
        "newClass": "COMMON",
        "tickerCodeSame": true
      },
      "expected": {
        "instrumentIdentitySame": false,
        "commonStockEligibilityInherited": false
      }
    },
    {
      "id": "ITC-07-EVENT-TIME-ELIGIBILITY-USES-ALIGNED-MASTER-AND-CAP-SNAPSHOT",
      "input": {
        "eventEffectiveAt": "SYNTH-T0",
        "masterObservedAt": "SYNTH-T1",
        "capObservedAt": "SYNTH-T2",
        "snapshotAligned": false
      },
      "expected": {
        "eligibleAtEvent": "UNRESOLVED",
        "currentMasterBackfillAllowed": false
      }
    },
    {
      "id": "ITC-08-WATCHLIST-SUCCESSOR-MATCH-IS-CONTEXT-ONLY-WITHOUT-APPROVED-RELATION",
      "input": {
        "eventSubjectInstrument": "SYNTH-INST-OLD",
        "watchlistInstrument": "SYNTH-INST-NEW",
        "successorEdgeApproved": false
      },
      "expected": {
        "directWatchlistMatch": false,
        "contextualSuccessorMatch": "UNRESOLVED",
        "alertAllowed": false
      }
    },
    {
      "id": "ITC-09-OVERLAPPING-CONFLICTING-ALIASES-QUARANTINE-ONLY-AFFECTED-SUBJECT",
      "input": {
        "sameMarket": true,
        "sameCode": true,
        "validIntervalsOverlap": true,
        "instrumentIds": [
          "SYNTH-INST-A",
          "SYNTH-INST-B"
        ]
      },
      "expected": {
        "mapping": "CONFLICTED",
        "affectedSubject": "SUPPRESSED",
        "unrelatedSubjectsChanged": false
      }
    },
    {
      "id": "ITC-10-PRICE-CONTINUITY-AND-IDENTITY-CONTINUITY-ARE-SEPARATE",
      "input": {
        "corporateAction": "SPLIT",
        "adjustedPriceSeriesContinuous": true,
        "identityRelationEvidence": false
      },
      "expected": {
        "instrumentIdentityMerge": false,
        "priceAdjustmentImpliesIdentity": false
      }
    },
    {
      "id": "ITC-11-UNVERIFIED-CODE-ALIAS-BLOCKS-COMMON-STOCK-RECOMMENDATION",
      "input": {
        "aliasReviewState": "UNRESOLVED",
        "masterLookup": "FAILED",
        "nameLooksLikeCommonStock": true
      },
      "expected": {
        "recommendation": false,
        "failClosed": true
      }
    },
    {
      "id": "ITC-12-MAPPING-CORRECTION-CREATES-NEW-ASSERTION-AND-INVALIDATES-DESCENDANTS",
      "input": {
        "priorAliasAssertion": "SYNTH-ALIAS-1",
        "newEvidenceChangesEffectiveInterval": true
      },
      "expected": {
        "oldAssertionImmutable": true,
        "newAssertionRequired": true,
        "affectedSubjectReviewRequired": true,
        "oldApprovalReused": false
      }
    },
    {
      "id": "ITC-13-OPENDART-MODIFY-DATE-IS-NOT-HISTORICAL-SECURITY-ALIAS",
      "input": {
        "corpCode": "SYNTH-CORP-13",
        "stockCode": "SYNTH-CODE-13",
        "modifyDate": "SYNTH-OVERVIEW-LAST-CHANGE",
