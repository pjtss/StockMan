      "expected": {
        "corpCodeRole": "LEGAL_ENTITY_OR_FILER_ID",
        "historicalAlias": "UNRESOLVED",
        "modifyDatePromotedToListingEffectiveDate": false
      }
    },
    {
      "id": "ITC-14-KRX-LIMITED-ISSUE-VIEW-ABSENCE-DOES-NOT-PROVE-NO-LISTING",
