      },
      "expected": {
        "completeHistoryClaim": false,
        "noAliasConclusion": "UNVERIFIABLE",
        "publicationOrAggregate": false
      }
    },
    {
      "id": "ITC-19-CROSSWALK-CANDIDATE-DOES-NOT-ACTIVATE-ELIGIBILITY",
