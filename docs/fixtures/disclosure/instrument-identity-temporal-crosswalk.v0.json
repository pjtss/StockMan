      },
      "expected": {
        "mutationAllowed": false,
        "assertionRevisionChanged": false,
        "reason": "AUTHORIZATION_SCOPE_OR_REVOCATION"
      }
    },
    {
      "id": "ITC-27-UNKNOWN-RIGHTS-BLOCK-PERSISTENCE-OF-SOURCE-BYTES-AND-HASH",
