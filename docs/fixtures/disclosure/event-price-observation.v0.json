{
  "contractVersion": "event-price-observation.v0",
  "classification": "SYNTHETIC_DESIGN_FIXTURES_NOT_RUNTIME_ACCEPTANCE",
  "dataPolicy": {
    "containsRealFiling": false,
    "containsRealIssuerOrTicker": false,
    "containsRealPriceSeries": false,
    "containsSourceBody": false,
    "hashesAreSyntheticLabels": true
  },
  "timePrecisionStates": ["EXACT_INSTANT", "DATE_ONLY", "UNKNOWN"],
  "priceObservationStates": ["OBSERVED_AS_OF", "LATEST_REVISED_ONLY", "MISSING", "BASIS_UNKNOWN", "CONFLICTED"],
  "reactionStates": ["REPRODUCIBLE_DESCRIPTIVE", "DAILY_ONLY_WINDOW_AMBIGUOUS", "NOT_REPRODUCIBLE", "NOT_COMPUTABLE", "CONFOUNDED", "CONFOUNDER_SCOPE_UNASSESSED", "EXPLORATORY_SENSITIVITY_ONLY", "PUBLICATION_TIME_UNVERIFIED"],
  "ownerControlledAnalysisPolicies": {
    "minimumSubgroupSampleSize": "NOT_SET_BY_OWNER",
    "multiplicityAdjustmentMethod": "NOT_SET_BY_OWNER",
    "confirmatorySignificanceThreshold": "NOT_SET_BY_OWNER",
    "inferentialPublicationApproval": "NOT_APPROVED"
  },
  "requiredSnapshotFields": ["snapshotId", "instrumentId", "marketAndVenue", "candleKey", "barStartOrDate", "barEnd", "observedAtUtc", "fetchedAtUtc", "sourceProvider", "sourceRevisionOrPayloadHash", "priceBasis", "currency", "sessionCalendarRevision", "corporateActionBasis", "snapshotManifestHash"],
  "requiredStudyFields": ["eventWindowPolicyId", "policyFrozenAt", "cohortDefinitionHash", "inclusionExclusionCounts", "comparatorPolicyRevision", "comparatorCandidateSetHash", "preEventContextWindowPolicyRevision", "confounderSearchScope", "sensitivityWindowSet", "subgroupFamilyId", "minimumSamplePolicyRevision", "multiplicityPolicyRevision", "analysisRunManifest", "analysisRunHash", "inputRevisionSetHash", "corporateActionRevisionSetHash", "dependencyClosureHash", "resultLineageStatus"],
  "requiredAnalysisRunManifestFields": ["algorithmVersion", "codeArtifactHash", "runtimeVersion", "canonicalization", "inputManifestHash", "policySetHash", "environmentFingerprint", "resultDigest"],
  "resultLineageStates": ["CURRENT", "STALE_INPUT_REVISION", "STALE_CORPORATE_ACTION", "STALE_BENCHMARK_REVISION", "REPLAY_REQUIRED", "REPRODUCIBILITY_MISMATCH", "RIGHTS_EXPIRED"],
  "revisionImpactContract": {
    "classification": "SYNTHETIC_DESIGN_ACCEPTANCE_NOT_RUNTIME_IMPLEMENTATION",
    "lineageBindings": ["price snapshot IDs and revisions", "corporate action basis/revision per instrument and window", "benchmark snapshot IDs and index membership/methodology revisions", "event-time and cohort policy revisions", "rights and retention decision revisions", "analysis code/runtime/canonicalization revision"],
    "impactRule": "A changed dependency expires the affected run and descendants; recompute only with available inputs and current replay rights; otherwise suppress current derived result and preserve prior run as historical audit.",
    "scopeRule": "Reopen results whose dependency closure intersects the changed price/benchmark/corporate-action source and window; leave disjoint source/subject results current only when non-dependency is proven.",
    "notRuntimeProof": true
  },
  "requiredReplayRightsFields": ["sourceAction", "rightsDecisionRevision", "allowedRetentionClass", "replayPayloadAvailability", "reexecutionPermission"],
  "requiredGovernanceDecisionIds": ["KR-MARKET-DATA-RIGHTS-01", "KR-RETENTION-01", "KR-EVENT-STUDY-POLICY-01", "KR-SHADOW-SLO-01", "KR-END-TO-END-ACCEPTANCE-01"],
  "analysisDigestExclusions": ["runId", "startedAt", "completedAt", "workerId"],
  "requiredCohortCoverageFields": ["candidateReceiptSetHash", "historicalInstrumentMasterRevision", "eligibilityAsOf", "listingLifecycleCoverage", "unresolvedEligibilityCount", "outcomeMissingnessDispositionByReason"],
  "announcementTimeBasisFields": ["filingAcceptedAt", "firstPublicAvailabilityAt", "timestampSource", "timezone", "precision", "availabilityEvidenceRef"],
