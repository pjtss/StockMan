      "id": "FCR-01-OBSERVATION-CORRECTION-DOES-NOT-AUTO-DECIDE-ECONOMIC-EFFECT",
      "input": {
        "sourceFactOld": "SYNTH-100",
        "sourceFactNew": "SYNTH-80",
        "revisionRelation": "RESOLVED_CORRECTS",
        "cashReceiptProof": null
      },
      "expected": {
        "sourceObservation": "SUPERSEDED",
        "normalizedTerms": "RECALCULATE",
        "actualCashImpact": "NOT_REPORTED",
        "interpretation": "REVIEW_REQUIRED"
      }
    },
    {
      "id": "FCR-02-UNRESOLVED-RELATION-DOES-NOT-SUPERSEDE",
      "input": {
        "newFilingMarker": "CORRECTION",
