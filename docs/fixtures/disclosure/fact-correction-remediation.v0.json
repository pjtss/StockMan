      "expected": {
        "affected": [
          "CASH-SYN-A",
          "DATE-SYN-A"
        ],
        "independent": "RETAIN_IF_CURRENT_AND_VALID",
        "missingEdge": "BROADER_SUPPRESSION"
      }
    },
