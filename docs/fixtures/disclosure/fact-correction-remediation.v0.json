{
  "contractVersion": "fact-correction-remediation.v0",
  "classification": "SYNTHETIC_DESIGN_FIXTURES_NOT_RUNTIME_ACCEPTANCE",
  "dataPolicy": {
    "containsRealFiling": false,
    "containsRealIssuerOrTicker": false,
    "containsSourceBody": false,
    "containsPersonalRecipientData": false,
    "hashesAreSyntheticLabels": true
  },
  "factLayers": [
    "SOURCE_OBSERVATION",
    "NORMALIZED_FACT",
    "INTERPRETATION",
    "INVESTMENT_EFFECT",
    "PUBLICATION"
  ],
  "impactStates": [
    "NO_DOWNSTREAM_IMPACT",
    "STALE_SUPPRESSED",
    "RECALCULATION_REQUIRED",
    "REVIEW_REQUIRED",
    "CORRECTED",
    "UNRESOLVED"
  ],
  "requiredImpactDimensions": [
    "claimId",
    "priorRevisionId",
    "newRevisionId",
    "sourceRelationId",
    "consumerType",
    "consumerRevisionId",
    "publicationEpoch",
    "deliveryId",
    "disposition",
    "rationaleRef"
  ],
  "vectors": [
