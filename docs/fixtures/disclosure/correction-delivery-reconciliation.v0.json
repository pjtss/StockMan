    "algorithm": "SHA-256",
    "domainSeparator": "KR-DISCLOSURE-EXPOSURE-SET-v1",
    "canonicalization": "RFC8785-JCS",
    "setOrder": "sort by UTF-8 bytes of exposureId; reject duplicate exposureId before hashing",
    "inputFields": ["exposureId", "exposureScope", "surfaceKind", "targetIdentityHash", "targetIdentityKeyId", "sourceRevision", "publicationEpoch", "disposition"],
    "formula": "SHA256(UTF8(domainSeparator) || 0x00 || UTF8(JCS(sorted exposure objects with declared inputFields)))",
