    "goldenVector": {
      "exposures": [
        { "disposition": "VISIBLE", "exposureId": "EXP-SYN-CARD-1", "exposureScope": "RECIPIENT_TARGET", "publicationEpoch": 8, "sourceRevision": "REV-SYN-2", "surfaceKind": "IN_APP_CARD", "targetIdentityHash": "hmac-sha256:SYNTH-USER-KEY-1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "targetIdentityKeyId": "SYNTH-USER-KEY-1" },
        { "disposition": "PROVIDER_ACCEPTED", "exposureId": "EXP-SYN-PUSH-1", "exposureScope": "RECIPIENT_TARGET", "publicationEpoch": 8, "sourceRevision": "REV-SYN-2", "surfaceKind": "WEB_PUSH_ENDPOINT", "targetIdentityHash": "hmac-sha256:SYNTH-KEY-1:f33dcd1c1b720021198332282d4754909b0f3d6fa1f7caea2453141078328297", "targetIdentityKeyId": "SYNTH-KEY-1" }
