  "requiredDeliveryDimensions": [
    "filingRevision",
    "recipient",
    "channel",
    "deliveryAttempt",
    "notificationRevision",
    "publicationEpoch"
  ],
  "requiredAttributionLineageFields": [
    "creditState",
    "creditManifestHash",
    "creditComponents",
    "payloadHash",
    "rendererRevision"
