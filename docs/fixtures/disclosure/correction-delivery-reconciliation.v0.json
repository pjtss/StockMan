    "ATTEMPTED_UNKNOWN",
    "PROVIDER_ACCEPTED",
    "DEVICE_DELIVERY_UNOBSERVED",
    "FAILED_RETRYABLE",
    "DELIVERED_UNRETRACTABLE",
    "EDIT_CONFIRMED",
    "DELETE_CONFIRMED",
    "SUPPRESSED_BEFORE_SEND"
  ],
