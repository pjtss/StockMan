    { "id": "ICSR-12-CORRECTION-SUPERSEDES-ONLY-LINKED-MOVEMENT", "expected": "PRESERVE_PRIOR_AND_RECONCILE_DEPENDENTS" },
    { "id": "ICSR-13-AUTHORIZED-AMOUNT-IS-NOT-ISSUED-OR-OUTSTANDING", "expected": "KEEP_AUTHORIZATION_SEPARATE_FROM_BALANCE" },
    { "id": "ICSR-14-PRINCIPAL-AND-POTENTIAL-SHARES-ARE-DIFFERENT-MEASURES", "expected": "NO_IMPLICIT_CONVERSION_OR_CROSS_SUM" },
