    { "id": "ICSR-08-MULTI-CURRENCY-PRINCIPAL-IS-NOT-SUMMED", "expected": "PRESERVE_CURRENCY_BUCKETS" },
    { "id": "ICSR-09-CORPORATE-ACTION-BASIS-MISMATCH-BLOCKS-SHARE-RATIO", "expected": "NOT_COMPUTABLE_UNTIL_BASIS_MATCH" },
