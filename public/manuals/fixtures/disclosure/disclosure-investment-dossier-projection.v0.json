{
  "contractVersion": "disclosure-investment-dossier-projection.v0",
  "classification": "SYNTHETIC_USER_DOSSIER_PROJECTION_NOT_RUNTIME_DTO_OR_INVESTMENT_ADVICE",
  "dataPolicy": {
    "containsRealFiling": false,
    "containsRealIssuerOrTicker": false,
    "containsSourceBody": false,
    "containsRealFinancialValues": false
  },
  "canonicalClaimFieldCrosswalk": {
    "claimId": "FactClaim.claimId",
    "claimType": "FactClaim.claimType",
    "claimText": "FactClaim.text",
    "issuerRole": "EventRevisionParty.role plus evidence-backed attribution status; never inferred from filing company label",
    "sourceReceiptId": "FactClaim.evidenceRefs[].sourceRef.filingId -> source catalog externalId",
    "documentRevisionId": "FactClaim.evidenceRefs[].sourceRef.documentRevisionId",
    "evidenceLocator": "FactClaim.evidenceRefs[].sourceRef.locator",
    "evidenceRelation": "FactClaim.evidenceRefs[].role: SUPPORTS | CONTRADICTS | CONTEXT",
    "verificationState": "FactClaim.verificationStatus",
    "rightsDecisionRevision": "FactClaim.evidenceRefs[].sourceRef.rightsDecisionId -> exact rights decision revision/snapshot",
    "counterEvidenceRefs": "Separate FactClaim records connected by CONTRADICTS; do not hide them in rationale text",
    "unknowns": "AnalysisRevision.unknowns[] with typed reason and declared review scope",
    "reviewDecisionRef": "SummarySegment.reviewDecision and AnalysisRevision.review, kept as different approval targets"
  },
  "projectionEnvelope": {
    "requiredSameSnapshotFields": [
      "eventRevisionId",
      "analysisRevisionId",
      "projectionSnapshotId",
      "asOf",
      "publicationEpoch",
      "rightsDecisionSetHash",
      "capitalStateRevisionId",
      "issuerRiskStateRevisionId",
      "instrumentUniverseHash",
      "subjectApplicabilityRevisionId"
    ],
    "requiredGateStates": [
      "publicationDisposition",
      "instrumentEligibility",
      "sourceCoverage",
      "documentAvailability",
      "analysisReview",
      "summaryReview",
      "capitalReconciliation",
      "issuerRiskTimeline",
      "capitalCoverage",
      "issuerStatusCoverage",
      "subjectApplicability",
      "instrumentFilterScope"
    ],
    "partialPayloadRule": "If a required gate suppresses a dossier, do not return body-derived claim cards, quantitative cards, analysis text, or a stale prior projection as fallback.",
    "noRecommendationRule": "Dossier may explain reviewed facts and scenarios but may not emit an imperative buy/sell instruction or guaranteed-return claim."
  },
  "sourceCoverageBinding": {
    "status": "PROPOSED_SYNTHETIC_BINDING_NOT_RUNTIME_DTO",
    "contractRef": "disclosure-source-coverage.v0.json#/coverageAssertionManifestContract",
    "queryScopeNormalizationRef": "disclosure-source-coverage.v0.json#/queryScopeNormalizationContract",
    "publicStatusMappingRef": "disclosure-dossier-public-read.v0.json#/negativeEvidenceContract/publicCoverageStatusMapping",
    "publicVocabularyRef": "disclosure-dossier-public-read.v0.json#/negativeEvidenceContract/publicCoverageMessageKo",
    "requiredFields": [
      "manifestId",
      "manifestDigest",
      "sourceProduct",
      "endpointOrSurface",
      "normalizedQueryHash",
      "issuerId",
      "instrumentId",
      "securityClassAndSeriesScope",
      "windowStart",
      "windowEnd",
      "correctionWatermarkAsOf",
      "correctionWatermarkState",
      "masterSnapshotId",
      "subjectApplicabilityRevisionId",
      "rightsDecisionSetHash",
      "coveragePolicyRevision",
      "coverageState"
    ],
    "sameProjectionFields": [
      "projectionSnapshotId",
      "asOf",
      "publicationEpoch",
      "subjectApplicabilityRevisionId",
      "investmentAnalysisRevisionSetHash",
      "investmentAnalysisLineageState"
    ],
    "aggregationRule": "Preserve one manifest reference per required sourceProduct × endpointOrSurface × normalizedQueryHash × declaredWindow × issuer/instrument scope; never collapse different sources or scopes into a single complete boolean.",
    "negativeEvidenceRule": "NOT_FOUND_IN_SCOPE requires a digest-verified RECONCILED_AS_OF manifest for the exact requested source/query/window/subject scope, permitted action and current rights/master/applicability revisions; otherwise use UNVERIFIABLE, SUPPRESSED_RIGHTS, or NOT_SEARCHED.",
    "publicStatusRule": "Project internal coverage states through the publicCoverageStatusMapping and approved Korean message keys; never expose internal state names or raw provider errors. NOT_FOUND_IN_SCOPE and NOT_REPORTED are result meanings, not coverage states.",
    "partialExportRule": "Export includes per-source manifest references, coverage states, withheld counts, and declared scope; omitted or withheld subjects never imply no event.",
    "notRuntimeProof": true
  },
  "sections": [
    {
      "id": "FILING_CONTEXT",
      "order": 1,
      "fields": [
        "source",
        "receiptId",
        "reportTitle",
        "filedDatePrecision",
        "sourceCaptureAt",
        "correctionRelationState"
      ],
      "metadataOnlyAllowed": true
    },
    {
      "id": "DOSSIER_STATE",
      "order": 2,
      "fields": [
        "outputState",
        "publicationDisposition",
        "sourceCoverage",
        "documentAvailability",
        "analysisReviewState",
        "lastVerifiedAt"
      ],
      "metadataOnlyAllowed": true
    },
    {
      "id": "AFFECTED_INSTRUMENT",
      "order": 3,
      "fields": [
        "issuerRole",
        "instrumentName",
        "instrumentCode",
        "commonStockEligibility",
        "marketCapEligibility",
        "directImpactEvidenceRefs"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "VERIFIED_FACTS",
      "order": 4,
      "fields": [
        "claimId",
        "claimText",
        "verificationState",
        "evidenceLocator",
        "sourceReceiptId",
        "documentRevisionId",
        "rightsDecisionRevision"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "QUANTITATIVE_EFFECTS",
      "order": 5,
      "fields": [
        "value",
        "unit",
        "currency",
        "numeratorClaimRef",
        "denominatorClaimRef",
        "periodOrStage",
        "formulaVersion",
        "reportedOrDerived"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "SUPPORTING_AND_CONTRADICTING_EVIDENCE",
      "order": 6,
      "fields": [
        "supportingClaimRefs",
        "counterEvidenceRefs",
        "contextRefs",
        "conflictState"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "EVENT_AND_DATES",
      "order": 7,
      "fields": [
        "eventType",
        "eventStatus",
        "dateKind",
        "value",
        "precision",
        "certainty",
        "status",
        "certaintyBasisClaimIds"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "RISKS_AND_UNKNOWNS",
      "order": 8,
      "fields": [
        "riskClaimRefs",
        "riskReviewCoverage",
        "unknownReasonCodes",
        "declaredReviewScope",
        "notAssessedFields"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "ISSUER_RISK_AND_MARKET_STATUS",
      "order": 10,
      "fields": [
        "issuerRiskStateRevisionId",
        "assertionState",
        "legalOrRegulatoryProcessState",
        "exchangeMarketActionState",
        "authorityScope",
        "affectedInstrumentIds",
        "effectiveAt",
        "observedAt",
        "stateAsOf",
        "coverageBySourceFamily",
        "correctionState",
        "conflictRefs"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "ISSUER_CAPITAL_STATE",
      "order": 9,
      "fields": [
        "capitalStateAsOf",
        "capitalObservedAt",
        "capitalCoverage",
        "reportedBaseSnapshotRef",
        "linkedMovementRefs",
        "securityClass",
        "seriesOrTrancheRefs",
        "issuedOutstandingListedMeasures",
        "unresolvedAmountsAndReasons",
        "reconciliationStatus",
        "applicabilityScope",
        "applicabilityInstrumentIds",
        "directImpactEvidenceRefs"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "REVIEWED_INTERPRETATION",
      "order": 11,
      "fields": [
        "direction",
        "horizon",
        "rationaleClaimIds",
        "counterEvidenceRefs",
        "limitations",
        "impactAssessmentConfidence",
        "reviewDecisionRef"
      ],
      "metadataOnlyAllowed": false
    },
    {
      "id": "DIDP-41-MASTER-CLASS-CORRECTION-INVALIDATES-ELIGIBILITY-AND-REOPENS-DOSSIER",
      "input": {
        "instrumentId": "SYNTH-COMMON-A",
