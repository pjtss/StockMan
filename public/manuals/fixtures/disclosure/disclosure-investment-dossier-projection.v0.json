        "fxConvertedValuePublished": false
      }
    },
    {
      "id": "DIDP-43-PRICE-REVISION-INVALIDATES-DEPENDENT-DOSSIER-RESULTS-ACROSS-CONSUMERS",
      "input": {
        "priorProjectionSnapshot": "PROJECTION-SYN-43-A",
        "priorAnalysisRun": {"runId": "RUN-SYN-43-A", "lineageState": "CURRENT", "dependencyClosure": ["PRICE-SNAPSHOT-SYN-43-A", "BENCHMARK-SYN-43-A"]},
        "changedPriceDependency": "PRICE-SNAPSHOT-SYN-43-A",
        "currentReplayInputAvailable": false,
        "currentReplayRights": "UNRESOLVED",
        "consumers": ["PUBLIC_API", "DOSSIER_UI", "USER_EXPORT", "NOTIFICATION", "CACHE_OR_CURSOR"],
        "unrelatedRawFactRunDependsOnChangedPrice": false
      },
      "expected": {
        "priorRunHistoryPreserved": true,
        "analysisLineageState": "STALE_INPUT_REVISION",
        "priceResultCurrentView": "SUPPRESSED",
        "directionalSummaryOrInvestmentScore": "NOT_PUBLISHED",
        "recomputeWithoutInputAndRights": false,
        "sameSnapshotMarksPriceResultStale": true,
        "allConsumersRevalidateSameLineageAndEpoch": true,
        "notificationDispatchAllowed": false,
        "unrelatedRawFactRunInvalidated": false,
        "priorProjectionUsedAsCurrentFallback": false,
        "internalReasonCodeExposed": false
      }
    }
  ],
  "emptyAndBlockedStateMap": {
    "NOT_ASSESSED": "No review/search was performed for the declared field or risk class.",
    "NOT_FOUND_IN_REVIEW_SCOPE": "A declared, sufficiently covered review scope was searched and no supporting item was located; this is not a universal absence claim.",
    "NOT_DISCLOSED": "An allowed source explicitly states the value/information is not disclosed.",
    "SOURCE_UNAVAILABLE": "The source/document could not be obtained or verified for this revision.",
    "RIGHTS_BLOCKED": "The requested fetch/parse/display action is not authorized or unresolved; content judgment is NOT_RUN.",
    "CONFLICT_UNRESOLVED": "Conflicting source claims remain visible as a conflict and no active normalized value is selected.",
    "NOT_APPLICABLE": "The field does not apply under the versioned taxonomy, with its basis recorded.",
    "EVIDENCE_INCOMPLETE": "Required evidence, attribution, or review gate is incomplete; do not interpret as absence or a negative conclusion."
  },
  "renderingRules": {
    "emptyStatesAreExplicit": true,
    "positiveAndCounterEvidenceUseSeparateCards": true,
    "riskCoverageMustAccompanyNoRiskResult": true,
    "unresolvedIssuerNeverShowsTickerAsAffectedSubject": true,
    "rightsBlockedContentNeverFallsBackToPriorRevision": true,
    "staleRevisionNeverAppearsAsCurrent": true,
    "confidenceIsNotProbability": true,
    "colorIsNotTheOnlyStatusSignal": true,
    "factAndInterpretationAreVisuallyDistinct": true,
    "capitalAndRiskStatesUseSeparateSections": true,
    "capitalMovementDoesNotImplyFinancialDistressOrExchangeAction": true,
    "issuerRiskObservationDoesNotImplyCapitalMovement": true,
    "currentIssuerStatusRequiresAuthorityAndCoverage": true,
    "historicalRiskAndCapitalAssertionsRemainVisibleAfterResolution": true,
    "unknownCapitalAndRiskCoverageCannotRenderAsClear": true,
    "issuerAndInstrumentScopesAreSeparate": true,
    "seriesAndTrancheFactsAreNotIssuerWideByDefault": true,
    "issuerContextIsNeverRenderedAsInstrumentClaim": true,
    "instrumentFilterDoesNotSilentlyDropOrPromoteIssuerContext": true,
    "everyRenderedClaimDeclaresApplicabilityScope": true,
    "unresolvedSubjectScopeBlocksInstrumentRecommendation": true,
    "conflictAndCoverageUnknownRenderAsDistinctStatuses": true,
    "conflictOrUnknownSuppressesDirectionalSummary": true
  },
