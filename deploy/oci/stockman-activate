#!/usr/bin/env bash
set -euo pipefail
stage="initialise"
on_error() {
  local code=$?
  echo "stockman-activate failed: stage=${stage} exit=${code}" >&2
  if [ "$stage" = "service-restart" ]; then
    systemctl --no-pager --full status stockman.service stockman-cron.timer >&2 || true
    journalctl --no-pager -u stockman.service -n 40 >&2 || true
  fi
  exit "$code"
}
trap on_error ERR

DEPLOY_PATH="${1:?deployment path is required}"
RELEASE="${2:?release archive is required}"
TEMP_PATH="${DEPLOY_PATH}.incoming"

rm -rf "$TEMP_PATH"
mkdir -p "$TEMP_PATH"
stage="extract-release"
tar -xzf "$RELEASE" -C "$TEMP_PATH"
chmod +x "$TEMP_PATH/scripts/oci-cron.sh"
chmod +x "$TEMP_PATH/scripts/oci-rss-cron.sh"
if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required for the Flyway migration container but was not found on OCI" >&2
  exit 1
fi
if [ ! -f /etc/stockman/stockman.env ]; then
  echo "/etc/stockman/stockman.env is required for Flyway DATABASE_URL" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1091
. /etc/stockman/stockman.env
set +a
: "${DATABASE_URL:?DATABASE_URL is required for Flyway}"
FLYWAY_IMAGE="${FLYWAY_IMAGE:-flyway/flyway:latest}"
DB_URL_WITHOUT_SCHEME="${DATABASE_URL#postgresql://}"
DB_URL_WITHOUT_SCHEME="${DB_URL_WITHOUT_SCHEME#postgres://}"
DB_AUTH="${DB_URL_WITHOUT_SCHEME%@*}"
DB_HOST_AND_NAME="${DB_URL_WITHOUT_SCHEME#*@}"
if [ "$DB_AUTH" = "$DB_URL_WITHOUT_SCHEME" ] || [ -z "$DB_AUTH" ] || [ -z "$DB_HOST_AND_NAME" ]; then
  echo "DATABASE_URL must include PostgreSQL credentials for Flyway" >&2
  exit 1
fi
FLYWAY_USER="${DB_AUTH%%:*}"
FLYWAY_PASSWORD="${DB_AUTH#*:}"
FLYWAY_JDBC_URL="jdbc:postgresql://${DB_HOST_AND_NAME}"
stage="flyway-migrate"
docker run --rm --network host \
  -v "$TEMP_PATH/db/migration:/flyway/sql:ro" \
  "$FLYWAY_IMAGE" \
  -url="$FLYWAY_JDBC_URL" \
  -user="$FLYWAY_USER" \
  -password="$FLYWAY_PASSWORD" \
  -locations="filesystem:/flyway/sql" \
  -connectRetries=3 \
  -outOfOrder=true \
  migrate
rm -f "$RELEASE"
stage="activate-files"
rm -rf "$DEPLOY_PATH.previous"
if [ -d "$DEPLOY_PATH" ]; then mv "$DEPLOY_PATH" "$DEPLOY_PATH.previous"; fi
mv "$TEMP_PATH" "$DEPLOY_PATH"
chown -R stockman:stockman "$DEPLOY_PATH"
stage="service-restart"
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-cron.service" /etc/systemd/system/stockman-cron.service
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-cron.timer" /etc/systemd/system/stockman-cron.timer
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-rss.service" /etc/systemd/system/stockman-rss.service
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-rss.timer" /etc/systemd/system/stockman-rss.timer
systemctl daemon-reload
systemctl restart stockman.service
systemctl enable stockman-cron.timer
systemctl restart stockman-cron.timer
systemctl enable stockman-rss.timer
systemctl restart stockman-rss.timer
# Run one scheduler pass immediately after activation so a fresh deployment
# never leaves the cache health view stale until the next calendar boundary.
systemctl start --no-block stockman-cron.service
systemctl is-active --quiet stockman.service
systemctl is-active --quiet stockman-cron.timer
systemctl is-active --quiet stockman-rss.timer

# Keep the reverse proxy upload limit in sync with the application release.
if command -v nginx >/dev/null 2>&1 && [ -f "$DEPLOY_PATH/deploy/oci/nginx-stockman.conf" ]; then
  stage="nginx-reload"
  install -m 0644 "$DEPLOY_PATH/deploy/oci/nginx-stockman.conf" /etc/nginx/conf.d/stockman.conf
  nginx -t
  systemctl reload nginx
fi

# Keep Discord application commands synchronized with every deployed release.
# Missing Discord credentials should not block a normal web deployment, but when
# configured the registration is a required, idempotent PUT operation.
if [ -n "${DISCORD_APPLICATION_ID:-}" ] && [ -n "${DISCORD_BOT_TOKEN:-}" ]; then
  stage="discord-command-sync"
  if ! runuser -u stockman -- env \
    DISCORD_APPLICATION_ID="$DISCORD_APPLICATION_ID" \
    DISCORD_BOT_TOKEN="$DISCORD_BOT_TOKEN" \
    DISCORD_GUILD_ID="${DISCORD_GUILD_ID:-}" \
    node "$DEPLOY_PATH/scripts/register-discord-commands.mjs"; then
    echo "WARNING: Discord command registration failed; release remains active" >&2
  fi
else
  echo "Discord command registration skipped: DISCORD_APPLICATION_ID or DISCORD_BOT_TOKEN is not configured" >&2
fi
