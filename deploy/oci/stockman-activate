#!/usr/bin/env bash
set -euo pipefail
stage="initialise"
SERVICES_QUIESCED=0
on_error() {
  local code=$?
  echo "stockman-activate failed: stage=${stage} exit=${code}" >&2
  if [ "$SERVICES_QUIESCED" = "1" ]; then
    echo "Restoring application and scheduler services after failed activation" >&2
    systemctl start stockman.service || true
    systemctl start stockman-cron.timer stockman-rss.timer stockman-fundamentals.timer || true
  fi
  if [ "$stage" = "service-restart" ]; then
    collect_service_diagnostics
  fi
  exit "$code"
}
trap on_error ERR

DEPLOY_PATH="${1:?deployment path is required}"
RELEASE="${2:?release archive is required}"
TEMP_PATH="${DEPLOY_PATH}.incoming"

on_exit() {
  local code=$?
  trap - EXIT
  if [ ! -e "$DEPLOY_PATH" ] && [ ! -L "$DEPLOY_PATH" ] \
    && { [ -e "$DEPLOY_PATH.previous" ] || [ -L "$DEPLOY_PATH.previous" ]; }; then
    echo "current release path is missing; restoring previous release" >&2
    if ! mv "$DEPLOY_PATH.previous" "$DEPLOY_PATH"; then
      echo "previous release restoration failed after interrupted activation" >&2
      code=1
    fi
  fi
  if { [ -e "$DEPLOY_PATH" ] || [ -L "$DEPLOY_PATH" ]; } \
    && { [ -e "$TEMP_PATH" ] || [ -L "$TEMP_PATH" ]; }; then
    if ! rm -rf "$TEMP_PATH"; then
      echo "failed release staging directory cleanup: $TEMP_PATH" >&2
      code=1
    fi
  fi
  exit "$code"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ ! -e "$DEPLOY_PATH" ] && [ ! -L "$DEPLOY_PATH" ] \
  && { [ -e "$DEPLOY_PATH.previous" ] || [ -L "$DEPLOY_PATH.previous" ]; }; then
  echo "recovering previous release before deployment preflight" >&2
  mv "$DEPLOY_PATH.previous" "$DEPLOY_PATH"
fi

stage="validate-archive"
if ! tar -tzf "$RELEASE" >/dev/null; then
  echo "release archive is invalid or incomplete" >&2
  exit 1
fi
rm -rf "$TEMP_PATH"
mkdir -p "$TEMP_PATH"
stage="extract-release"
tar -xzf "$RELEASE" -C "$TEMP_PATH"
chmod +x "$TEMP_PATH/scripts/oci-cron.sh"
chmod +x "$TEMP_PATH/scripts/oci-fundamentals-cron.sh"
chmod +x "$TEMP_PATH/scripts/oci-rss-cron.sh"
chmod +x "$TEMP_PATH/scripts/oci-flyway-v168-preflight.mjs"
chmod +x "$TEMP_PATH/scripts/terminate-approved-oci-snapshot-holders.mjs"
# Keep hashed static assets from the previous release available for clients
# that still hold an older HTML document during a browser/proxy cache transition.
# New assets already present in the incoming release win.
if [ -d "$DEPLOY_PATH/.next-deploy-verify/static" ] && [ -d "$TEMP_PATH/.next-deploy-verify/static" ]; then
  cp -rn "$DEPLOY_PATH/.next-deploy-verify/static/." "$TEMP_PATH/.next-deploy-verify/static/"
fi
if [ -d "$DEPLOY_PATH/public/_next/static" ] && [ -d "$TEMP_PATH/public/_next/static" ]; then
  cp -rn "$DEPLOY_PATH/public/_next/static/." "$TEMP_PATH/public/_next/static/"
fi
stage="flyway-preflight"
if ! command -v docker >/dev/null 2>&1; then
  echo "stockman-activate failed: stage=${stage}: docker is required for the Flyway migration container but was not found on OCI" >&2
  exit 1
fi
if [ ! -f /etc/stockman/stockman.env ]; then
  echo "stockman-activate failed: stage=${stage}: /etc/stockman/stockman.env is required for Flyway DATABASE_URL" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1091
. /etc/stockman/stockman.env
set +a
: "${DATABASE_URL:?stage=flyway-preflight DATABASE_URL is required for Flyway}"
FLYWAY_IMAGE="${FLYWAY_IMAGE:-flyway/flyway:latest}"
DB_URL_WITHOUT_SCHEME="${DATABASE_URL#postgresql://}"
DB_URL_WITHOUT_SCHEME="${DB_URL_WITHOUT_SCHEME#postgres://}"
DB_AUTH="${DB_URL_WITHOUT_SCHEME%@*}"
DB_HOST_AND_NAME="${DB_URL_WITHOUT_SCHEME#*@}"
if [ "$DB_AUTH" = "$DB_URL_WITHOUT_SCHEME" ] || [ -z "$DB_AUTH" ] || [ -z "$DB_HOST_AND_NAME" ]; then
  echo "stockman-activate failed: stage=${stage}: DATABASE_URL must include PostgreSQL credentials for Flyway" >&2
  exit 1
fi
FLYWAY_USER="${DB_AUTH%%:*}"
FLYWAY_PASSWORD="${DB_AUTH#*:}"
FLYWAY_JDBC_URL="jdbc:postgresql://${DB_HOST_AND_NAME}"

# Pause application and scheduled DB work while V168 builds concurrent indexes.
# This prevents new application snapshots from continuously delaying the
# migration. on_error restores the existing release and timers if migration fails.
stage="quiesce-services"
SERVICES_QUIESCED=1
for unit in stockman-cron.timer stockman-rss.timer stockman-fundamentals.timer; do
  timeout --signal=TERM --kill-after=10s 30s systemctl stop "$unit"
done
for unit in stockman-cron.service stockman-rss.service stockman-fundamentals.service stockman.service; do
  timeout --signal=TERM --kill-after=10s 30s systemctl stop "$unit"
done

stage="terminate-explicitly-approved-snapshot-pid"
runuser -u stockman -- env \
  OCI_PG_TERMINATION_APPROVED_SCOPE=explicit-approved-pids \
    OCI_PG_TERMINATION_APPROVED_PIDS=246213,246722,246903,247294,247463,247509,248010,248077,248691,248857,249223,249386,249548,249564,249815,249816,250094,250277,250401,250475,250476,250751,253038,260900,261867 \
  DATABASE_URL="$DATABASE_URL" \
  node "$TEMP_PATH/scripts/terminate-approved-oci-snapshot-holders.mjs"

stage="flyway-migrate"
preflight_output=""
preflight_log="$TEMP_PATH/v168-preflight.log"
preflight_attempt=1
while true; do
  if preflight_output="$(runuser -u stockman -- env DATABASE_URL="$DATABASE_URL" \
    node "$TEMP_PATH/scripts/oci-flyway-v168-preflight.mjs" \
      "$TEMP_PATH/db/migration/V168__bounded_non_daily_data_retention.sql" \
      "$TEMP_PATH/db/migration/V170__sec_materializer_recent_index.sql" 2>"$preflight_log")"; then
    cat "$preflight_log" >&2
    break
  else
    preflight_status=$?
    cat "$preflight_log" >&2
    if ! grep -q "V168/V170 preflight found old database snapshots" "$preflight_log" || [ "$preflight_attempt" -ge 20 ]; then
      exit "$preflight_status"
    fi
    echo "V168/V170 preflight: old snapshots remain; retrying in 30 seconds (attempt ${preflight_attempt}/20)" >&2
    sleep 30
    preflight_attempt=$((preflight_attempt + 1))
  fi
done
printf '%s\n' "$preflight_output"
if [[ "$preflight_output" == *'"repairRequired":true'* ]]; then
  stage="flyway-repair-v168-v170"
  timeout --signal=TERM --kill-after=30s 120s docker run --rm --network host \
    -v "$TEMP_PATH/db/migration:/flyway/sql:ro" \
    "$FLYWAY_IMAGE" \
    -url="$FLYWAY_JDBC_URL" \
    -user="$FLYWAY_USER" \
    -password="$FLYWAY_PASSWORD" \
    -locations="filesystem:/flyway/sql" \
    -ignoreMigrationPatterns="*:ignored" \
    -connectRetries=3 \
    repair
fi
stage="flyway-migrate"
timeout --signal=TERM --kill-after=30s 2400s docker run --rm --network host \
  -v "$TEMP_PATH/db/migration:/flyway/sql:ro" \
  "$FLYWAY_IMAGE" \
  -url="$FLYWAY_JDBC_URL" \
  -user="$FLYWAY_USER" \
  -password="$FLYWAY_PASSWORD" \
  -locations="filesystem:/flyway/sql" \
  -ignoreMigrationPatterns="*:ignored" \
  -connectRetries=3 \
  migrate
if [ -f "$TEMP_PATH/data/market-impact-events.json" ]; then
  stage="market-impact-events-import"
  runuser -u stockman -- env DATABASE_URL="$DATABASE_URL" \
    node "$TEMP_PATH/scripts/import-market-impact-events.mjs" "$TEMP_PATH/data/market-impact-events.json"
fi
rm -f "$RELEASE"
stage="activate-files"
had_previous_release=0
if [ -e "$DEPLOY_PATH" ] || [ -L "$DEPLOY_PATH" ]; then
  rm -rf "$DEPLOY_PATH.previous"
  mv "$DEPLOY_PATH" "$DEPLOY_PATH.previous"
  had_previous_release=1
fi
if mv "$TEMP_PATH" "$DEPLOY_PATH"; then
  :
else
  move_error=$?
  if [ "$had_previous_release" -eq 1 ] && [ ! -e "$DEPLOY_PATH" ]; then
    if ! mv "$DEPLOY_PATH.previous" "$DEPLOY_PATH"; then
      echo "release activation failed and previous release could not be restored" >&2
    fi
  fi
  exit "$move_error"
fi
chown -R stockman:stockman "$DEPLOY_PATH"
stage="service-restart"
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-cron.service" /etc/systemd/system/stockman-cron.service
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-cron.timer" /etc/systemd/system/stockman-cron.timer
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-rss.service" /etc/systemd/system/stockman-rss.service
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-rss.timer" /etc/systemd/system/stockman-rss.timer
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-fundamentals.service" /etc/systemd/system/stockman-fundamentals.service
install -m 0644 "$DEPLOY_PATH/deploy/oci/stockman-fundamentals.timer" /etc/systemd/system/stockman-fundamentals.timer
timeout --signal=TERM --kill-after=10s 30s systemctl daemon-reload
# Do not hold the SSH deployment session while systemd waits for the old
# Next.js process to stop. The service is checked below after the restart job
# has been queued, so a stuck process cannot make the deployment hang forever.
timeout --signal=TERM --kill-after=10s 30s systemctl restart --no-block stockman.service
systemctl enable stockman-cron.timer
timeout --signal=TERM --kill-after=10s 30s systemctl restart stockman-cron.timer
timeout --signal=TERM --kill-after=10s 30s systemctl enable stockman-rss.timer
timeout --signal=TERM --kill-after=10s 30s systemctl restart stockman-rss.timer
timeout --signal=TERM --kill-after=10s 30s systemctl enable stockman-fundamentals.timer
timeout --signal=TERM --kill-after=10s 30s systemctl restart stockman-fundamentals.timer
# Run one scheduler pass immediately after activation so a fresh deployment
# never leaves the cache health view stale until the next calendar boundary.
timeout --signal=TERM --kill-after=10s 30s systemctl start --no-block stockman-cron.service
timeout --signal=TERM --kill-after=10s 30s systemctl start --no-block stockman-fundamentals.service
for attempt in $(seq 1 60); do
  if systemctl is-active --quiet stockman.service && probe_stockman_health; then break; fi
  if [ "$attempt" -eq 60 ]; then
    if systemctl is-active --quiet stockman.service; then
      echo "stockman.service is active but GET /api/health did not return HTTP 200 within 60 attempts" >&2
    else
      echo "stockman.service did not become active within 60 attempts" >&2
    fi
    collect_service_diagnostics
    exit 1
  fi
  # /api/health checks schema and automation history on every request. Back
  # off between failures to avoid repeatedly querying the database while it is
  # still recovering, while retaining a short first retry for normal startup.
  retry_delay=$((attempt < 6 ? attempt * 2 : 10))
  sleep "$retry_delay"
done
systemctl is-active --quiet stockman-cron.timer
systemctl is-active --quiet stockman-rss.timer
systemctl is-active --quiet stockman-fundamentals.timer
SERVICES_QUIESCED=0

# Keep the reverse proxy upload limit in sync with the application release.
if command -v nginx >/dev/null 2>&1 && [ -f "$DEPLOY_PATH/deploy/oci/nginx-stockman.conf" ]; then
  stage="nginx-reload"
  install -m 0644 "$DEPLOY_PATH/deploy/oci/nginx-stockman.conf" /etc/nginx/conf.d/stockman.conf
  nginx -t
  systemctl reload nginx
fi

# Keep Discord application commands synchronized with every deployed release.
# Missing Discord credentials should not block a normal web deployment, but when
# configured the registration is a required, idempotent PUT operation.
if [ -n "${DISCORD_APPLICATION_ID:-}" ] && [ -n "${DISCORD_BOT_TOKEN:-}" ]; then
  stage="discord-command-sync"
  if ! runuser -u stockman -- env \
    DISCORD_APPLICATION_ID="$DISCORD_APPLICATION_ID" \
    DISCORD_BOT_TOKEN="$DISCORD_BOT_TOKEN" \
    DISCORD_GUILD_ID="${DISCORD_GUILD_ID:-}" \
    node "$DEPLOY_PATH/scripts/register-discord-commands.mjs"; then
    echo "WARNING: Discord command registration failed; release remains active" >&2
  fi
else
  echo "Discord command registration skipped: DISCORD_APPLICATION_ID or DISCORD_BOT_TOKEN is not configured" >&2
fi
