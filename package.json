{
  "name": "rss-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-next.mjs .next-dev",
    "dev": "node scripts/dev-server.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rss-translation-coverage": "node scripts/check-market-rss-translation-coverage.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:kis-boundary": "node scripts/audit-kis-boundary.mjs",
    "audit:bearer-auth": "node scripts/audit-bearer-auth.mjs",
    "measure:verify": "node scripts/measure-verify.mjs",
    "compare:verify": "node scripts/compare-verify.mjs",
    "audit:verify-scope": "node scripts/audit-verify-scope-change.mjs",
    "cron:check": "node scripts/check-oci-cron.mjs",
    "measure:accumulation": "node scripts/measure-accumulation-api.mjs",
    "measure:screener-db": "node scripts/measure-screener-db.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:verify": "node scripts/verify-deploy.mjs",
    "sync:daily-cache": "node --env-file=.env.local scripts/sync-daily-cache-from-remote.mjs",
    "verify": "npm test -- --run && npm run typecheck && npm run docs:check && npm run audit:verify-scope && npm run audit:kis-boundary && npm run audit:bearer-auth && npm run cron:check && npm run build"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.0",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.24.0",
    "next": "^15.2.4",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
